<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Proton.Sdk</PackageId>
    <Version>0.26.0-rust</Version>
    <Authors>Proton AG</Authors>
    <Description>Repackaged from the official Proton Drive Windows client 3.0.9 for local builds of the open source repository. Not an official Proton package.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(LocalRefsDir)\Proton.Sdk.dll" Pack="true" PackagePath="lib/net10.0/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.HighPerformance" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Proton.Cryptography" Version="0.32.0-rust.2" />
    <PackageReference Include="SQLite" Version="3.53.4" />
    <PackageReference Include="SQLitePCLRaw.config.e_sqlite3" Version="3.0.5" />
  </ItemGroup>

</Project>
