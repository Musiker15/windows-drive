<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Proton.Cryptography</PackageId>
    <Version>0.28.0</Version>
    <Authors>Proton AG</Authors>
    <Description>Repackaged from the official Proton Drive Windows client 3.0.4 for local builds of the open source repository. Not an official Proton package.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(LocalRefsDir)\Proton.Cryptography.dll" Pack="true" PackagePath="lib/net10.0/" />
    <None Include="$(NativeRefsDir)\proton_crypto.dll" Pack="true" PackagePath="runtimes/win-x64/native/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.HighPerformance" Version="8.4.2" />
  </ItemGroup>

</Project>
