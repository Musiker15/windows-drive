<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Proton.Drive.Sdk</PackageId>
    <Version>0.17.0</Version>
    <Authors>Proton AG</Authors>
    <Description>Repackaged from the official Proton Drive Windows client 3.0.4 for local builds of the open source repository. Not an official Proton package.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(LocalRefsDir)\Proton.Drive.Sdk.dll" Pack="true" PackagePath="lib/net10.0/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
    <PackageReference Include="Polly" Version="8.6.6" />
    <PackageReference Include="Proton.Cryptography" Version="0.28.0" />
    <PackageReference Include="Proton.Sdk" Version="0.17.0" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.5" />
  </ItemGroup>

</Project>
