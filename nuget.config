<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      Proton.Cryptography and Proton.Drive.Sdk are not published on nuget.org and this repository
      ships no feed for them. The packages in localfeed are repackaged from the assemblies bundled
      in the official Proton Drive client, see BUILDING.md.
    -->
    <add key="proton-local" value="localfeed" />
  </packageSources>
</configuration>
